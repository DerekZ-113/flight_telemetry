# Build output (build/, build-cov/, ...)
build*/

# Runtime logs written by ./telemetry. An ADS-B session's log and its telemetry_adsb.csv stay
# here too: the OpenSky Network's terms forbid redistributing what it returns.
logs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store

# Generated reports (committed selectively, not the whole folder)
coverage/*.html
coverage/*.info
coverage/html/
static_analysis/*.txt

# Python virtual environment for the receiver (recreate from requirements.txt) and bytecode
.venv/
__pycache__/

# Private context and local Claude Code state (never committed)
CLAUDE.local.md
.claude/settings.local.json
.claude/launch.json
.claude/worktrees/

# Python tests
.pytest_cache/

# The dashboard's installed packages, build and coverage output (recreate with npm ci)
dashboard/node_modules/
dashboard/dist/
dashboard/coverage/

# captures/ is not ignored: a raw sensor capture is committed selectively, like the
# coverage reports, when it sets constants (docs/noise_profile.md). Other captures stay out.
